{
  "services": {
    "app": {
      "image": "${GEO_VERIFIED_IMAGE:?verified image is required}",
      "pull_policy": "never",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 128,
      "mem_limit": "512m",
      "cpus": 1,
      "restart": "unless-stopped",
      "expose": [
        "3000"
      ],
      "tmpfs": [
        "/tmp:size=64m,mode=1777"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "20s"
      }
    },
    "web": {
      "image": "nginxinc/nginx-unprivileged:1.29-alpine",
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 64,
      "mem_limit": "64m",
      "cpus": 0.5,
      "expose": [
        "8080"
      ],
      "tmpfs": [
        "/tmp:size=32m,mode=1777"
      ],
      "volumes": [
        "/srv/storage/sda/apps/geo/source/deploy/public.nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      ],
      "depends_on": {
        "app": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "-O",
          "/dev/null",
          "http://127.0.0.1:8080/healthz"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "20s"
      }
    }
  }
}
