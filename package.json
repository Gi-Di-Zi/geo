{
  "name": "geo-web-showcase",
  "private": true,
  "engines": {
    "node": "^22.21.0 || >=24.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/copy-cesium.ts",
    "setup": "node scripts/setup.ts",
    "unreal": "node scripts/unreal.ts",
    "pipeline": "node scripts/pipeline.ts",
    "services": "docker compose up -d --wait",
    "check": "node scripts/check.ts",
    "thumbs": "node scripts/thumbs.ts",
    "test:viz": "node --test tests/viz/portfolio.test.ts",
    "link:reference": "node --env-file-if-exists=.env scripts/link-reference.ts",
    "link:administrative": "node --env-file-if-exists=.env scripts/link-administrative.ts",
    "link:maintenance": "node --env-file-if-exists=.env scripts/link-maintenance.ts",
    "test:link": "node scripts/test-link.ts",
    "test:link:unit": "node --test tests/link/core.test.ts tests/link/reference.test.ts tests/link/administrative.test.ts tests/link/administrative-service.test.ts tests/link/reference-updates.test.ts tests/link/location.test.ts tests/link/location-resolve.test.ts tests/link/all.test.ts tests/link/boundary.test.ts tests/link/files.test.ts tests/link/jobs.test.ts tests/link/chunks.test.ts",
    "lint": "node scripts/lint-scope.mjs",
    "test:lint": "node --test scripts/lint-scope.test.mjs",
    "predev": "npm run lint",
    "prebuild": "npm run lint",
    "pregenerate": "npm run lint",
    "presetup": "npm run lint",
    "prepipeline": "npm run lint",
    "precheck": "npm run lint",
    "pretest:viz": "npm run lint",
    "pretest:lint": "npm run lint",
    "test:mcp-app": "node --test tests/viz/mcp-app.test.ts",
    "pretest:mcp-app": "npm run lint"
  },
  "dependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/geo-layers": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/maplibre": "~9.4.0",
    "@deck.gl/mesh-layers": "~9.4.0",
    "@loaders.gl/3d-tiles": "^4.5.4",
    "@loaders.gl/core": "^4.5.4",
    "@loaders.gl/gltf": "^4.5.4",
    "@loaders.gl/mvt": "^4.5.4",
    "@mapbox/shp-write": "0.4.3",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "archiver": "^7.0.1",
    "cesium": "^1.146.0",
    "exceljs-community": "5.2.1",
    "maplibre-gl": "^6.14.0",
    "nuxt": "^4.6.1",
    "ol": "^10.11.0",
    "ol-pmtiles": "^2.0.2",
    "pmtiles": "^4.5.0",
    "proj4": "2.22.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "1.64.1",
    "@types/archiver": "^6.0.4",
    "esbuild": "0.28.2",
    "oxlint": "1.90.0"
  }
}
