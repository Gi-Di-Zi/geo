# 사이트 배경지도 (VWorld WMTS). 없으면 OSM으로 바뀐다. https://www.vworld.kr/dev/v4api.do
NUXT_PUBLIC_VWORLD_KEY=

# 서버 수집·주소/위치 조회 전용 (사이트에 노출되지 않음)
VWORLD_KEY=
# 법정동 경계 SHP: VWorld 키를 발급받을 때 등록한 서비스 URL을 글자 그대로 (예: http://localhost). 포트·경로가 다르면 INCORRECT_KEY
VWORLD_DOMAIN=
DATA_GO_KR_KEY=

# 서비스 레시피 서버 (compose.yaml). GeoServer 관리자 비밀번호 — 바꾼 뒤 처음 띄울 때만 적용
GEOSERVER_ADMIN_PASSWORD=

# 엔진 렌더러 (npm run unreal, 선택). 언리얼 설치 폴더 — 비우면 C:/Program Files/Epic Games/UE_5.8
UE_ROOT=
# 업로드 결과 실시간 보기(MCP geo_engine)를 보는 사람 없이 둘 시간(분). 비우면 10
ENGINE_IDLE_MIN=

# MCP (README "MCP"). 결과 주소에 쓸 바깥 주소 (터널·프록시 뒤, 예: https://geo.example.com). 비우면 요청 주소
PUBLIC_URL=
# AI가 이 PC 파일 경로(path)로 맡기기: 1 = 허용 (localhost 요청만). 비우면 개발 서버만 허용
MCP_LOCAL_PATHS=

# 국내 주소·코드 연계. 기본값은 아래와 같으며 필요할 때만 조정합니다.
LINK_REFERENCE_DIR=.data/reference/link
LINK_ADMINISTRATIVE_DIR=.data/reference/link/administrative
LINK_REFERENCE_UPDATE_DIR=.data/reference/link/updates
LINK_DATA_DIR=.data/link
LINK_UPLOAD_BYTES=20971520
LINK_MAX_ROWS=50000
LINK_SYNC_ROWS=200
LINK_UNCOMPRESSED_BYTES=41943040
LINK_MAX_COLUMNS=200
LINK_JOB_TTL_MS=86400000
LINK_JOB_TIMEOUT_MS=120000
LINK_JOB_CONCURRENCY=2
LINK_MAX_QUEUED_JOBS=20
LINK_MAX_RESULT_ROWS=100000
LINK_MAX_RESULT_BYTES=62914560
