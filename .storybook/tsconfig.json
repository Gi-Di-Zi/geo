{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "#shared/*": ["../shared/*"],
      "#build/catalog-formats": ["./fixtures/catalog-formats.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.vue"]
}
